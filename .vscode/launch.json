{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PaperView VS Code Extension (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "PaperView: Compile VS Code Extension"
    }
  ]
}
